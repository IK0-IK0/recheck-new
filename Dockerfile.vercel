FROM dunglas/frankenphp:1-php8.5-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions \
        bcmath \
        curl \
        exif \
        gd \
        intl \
        mbstring \
        pdo_mysql \
        pdo_pgsql \
        pdo_sqlite \
        zip

WORKDIR /app

FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-bookworm-slim /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

# Copy application files in smaller batches to avoid buildah segfault
COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database ./database
COPY public ./public
COPY resources ./resources
COPY routes ./routes
COPY artisan .
COPY package.json package-lock.json tsconfig.json vite.config.ts eslint.config.js ./
COPY Caddyfile .

RUN mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative \
    && php artisan wayfinder:generate --with-form --no-interaction \
    && node /usr/local/lib/node_modules/npm/bin/npm-cli.js ci \
    && node /usr/local/lib/node_modules/npm/bin/npm-cli.js run build \
    && rm -rf node_modules

FROM base AS runtime

WORKDIR /app

ENV APP_ENV=production \
    APP_DEBUG=false \
    DB_CONNECTION=pgsql \
    PORT=80 \
    LOG_CHANNEL=stderr \
    CACHE_STORE=array \
    SESSION_DRIVER=cookie \
    SESSION_ENCRYPT=true \
    SESSION_SECURE_COOKIE=true \
    QUEUE_CONNECTION=sync \
    VIEW_COMPILED_PATH=/tmp/laravel/views

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && mkdir -p /tmp/laravel/views \
    && chown -R www-data:www-data /tmp/laravel /app/storage /app/bootstrap/cache

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
